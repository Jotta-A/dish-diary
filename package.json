{
  "name": "projeto-dishdiary",
  "version": "1.0.0",
  "description": "DishDiary - recipe tracking app",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sass:build": "sass assets/sass/main.scss assets/styles/main.css --style=expanded",
    "sass:watch": "sass assets/sass/main.scss assets/styles/main.css --style=expanded --watch",
    "dev": "npm run sass:watch",
    "server": "json-server --watch db.json --port 3000",
    "dev:all": "npm run server",
    "start": "parcel index.html",
    "clean": "rd /s /q .parcel-cache 2>nul & rd /s /q dist 2>nul & exit 0",
    "build": "npm run clean && parcel build index.html home.html dish-detail.html log-meal.html login.html profile.html dish.html --public-url /dish-diary/",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jotta-A/dish-diary.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Jotta-A/dish-diary/issues"
  },
  "homepage": "https://Jotta-A.github.io/dish-diary",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "json-server": "^1.0.0-beta.15",
    "parcel": "^2.16.4",
    "sass": "^1.100.0"
  }
}
